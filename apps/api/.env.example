# 本地开发参数；将本文件复制为 .env，填写实际凭据。不要提交 .env。
# 远端 PostgreSQL 经 SSH 隧道映射到本机 15432；本地 Compose 默认相同端口。
CSF_DATABASE_URL=postgresql+psycopg://cstf_app:replace-with-a-random-password@127.0.0.1:15432/cstf_dev
# 所有 API 错误以业务码和 request_id 返回；不输出数据库凭据。
CSF_ENVIRONMENT=development
# 浏览器发起写操作时 Origin 必须与此值完全一致（不含尾部斜杠）。
CSF_PUBLIC_ORIGIN=http://localhost:3000
# 默认开启 Secure Cookie；仅在本机 HTTP 开发时显式设为 false，正式环境必须 true。
CSF_COOKIE_SECURE=true
# 会话与家长再次验证窗口，单位秒；均必须为正值。
CSF_SESSION_LIFETIME_SECONDS=604800
CSF_PARENT_VERIFICATION_SECONDS=300
# 每来源 IP+账号每窗口最多 10 次认证请求；同 IP 总上限为此值的 5 倍。
CSF_AUTH_RATE_LIMIT=10
CSF_AUTH_RATE_WINDOW_SECONDS=300


# 显式初始化管理员时必填；普通 API 启动不自动创建/覆盖账号。
# 无内置默认密码，首次登录须修改；账号至少 3 字符，密码 12–128 字符。
CSF_BOOTSTRAP_ADMIN_LOGIN=admin
CSF_BOOTSTRAP_ADMIN_PASSWORD=

# 外部备份由运营者建立与清理；0 表示本应用未配置外部备份。
CSF_BACKUP_RETENTION_DAYS=0
# 私有持久目录，必须独立于数据库备份并禁止 Web 访问。
CSF_DELETION_JOURNAL=private-content/deletions.jsonl
